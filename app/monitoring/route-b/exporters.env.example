# Copy to /etc/minibank/exporters.env, replace the <...> values, then: sudo chown root:root /etc/minibank/exporters.env; sudo chmod 600 /etc/minibank/exporters.env
# Use only letters and digits in passwords.
# Oracle AI Database Metrics Exporter (port 9161); MINIBANK_MON needs SELECT_CATALOG_ROLE (db/oracle/01-minibank-user.sql)
DB_USERNAME=MINIBANK_MON
DB_PASSWORD=<ORACLE-MON-PASSWORD>
DB_CONNECT_STRING=192.168.110.32:1521/FREEPDB1
# postgres_exporter (port 9187); role postgres_exporter with pg_monitor (db/postgres/01-minibank-db.sql)
DATA_SOURCE_NAME=postgresql://postgres_exporter:<PG-EXPORTER-PASSWORD>@127.0.0.1:5432/minibank?sslmode=disable
