# Copy to /etc/minibank/dbsnap.env, replace the <...> values, then: sudo chown root:root /etc/minibank/dbsnap.env; sudo chmod 600 /etc/minibank/dbsnap.env
# Read by /opt/minibank/dbsnap/minibank-dbsnap.sh. Use only letters and digits in passwords.
ORACLE_CONTAINER=minibank-oracle
ORACLE_MON_USER=MINIBANK_MON
ORACLE_MON_PASSWORD=<ORACLE-MON-PASSWORD>
ORACLE_ALERT_LOG=/opt/oracle/diag/rdbms/free/FREE/trace/alert_FREE.log
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=minibank
PG_MON_USER=postgres_exporter
PG_MON_PASSWORD=<PG-EXPORTER-PASSWORD>
DBSNAP_FILE=/var/log/minibank/dbsnap.json
