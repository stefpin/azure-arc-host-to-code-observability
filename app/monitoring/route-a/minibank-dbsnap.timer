# /etc/systemd/system/minibank-dbsnap.timer  (APP-RHEL)
# Enable: sudo systemctl daemon-reload && sudo systemctl enable --now minibank-dbsnap.timer
[Unit]
Description=Run minibank-dbsnap every 60 seconds

[Timer]
OnBootSec=2min
OnUnitActiveSec=60s
AccuracySec=5s
Unit=minibank-dbsnap.service

[Install]
WantedBy=timers.target
