# /etc/systemd/system/minibank-fraud.service  (APP-RHEL)
[Unit]
Description=MiniBank fraud-check service (Python FastAPI, port 8082)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
User=minibank
Group=minibank
WorkingDirectory=/opt/minibank/fraud
# PG_DSN, APPLICATIONINSIGHTS_CONNECTION_STRING, OTEL_SERVICE_NAME (file owned by root, mode 600)
EnvironmentFile=/etc/minibank/fraud.env
ExecStart=/opt/minibank/fraud/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8082
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
