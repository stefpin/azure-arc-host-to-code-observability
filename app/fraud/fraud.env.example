# Copy to /etc/minibank/fraud.env, replace the <...> values, then: sudo chown root:root /etc/minibank/fraud.env; sudo chmod 600 /etc/minibank/fraud.env
# Use only letters and digits in passwords.
PG_DSN=postgresql://minibank_app:<PG-APP-PASSWORD>@127.0.0.1:5432/minibank
APPLICATIONINSIGHTS_CONNECTION_STRING=<APPLICATIONINSIGHTS-CONNECTION-STRING>
OTEL_SERVICE_NAME=minibank-fraud
