{
  "dataFlows": [
    {
      "destinations": [
        "law"
      ],
      "outputStream": "Custom-MiniBankDbSnap_CL",
      "streams": [
        "Custom-Json-MiniBankDbSnap_CL"
      ],
      "transformKql": "source"
    }
  ],
  "dataSources": {
    "logFiles": [
      {
        "filePatterns": [
          "/var/log/minibank/dbsnap.json"
        ],
        "format": "json",
        "name": "minibankDbSnapJson",
        "streams": [
          "Custom-Json-MiniBankDbSnap_CL"
        ]
      }
    ]
  },
  "description": "MiniBank Route A: Oracle and PostgreSQL snapshots from APP-RHEL",
  "destinations": {
    "logAnalytics": [
      {
        "name": "law",
        "workspaceId": "<WORKSPACE_ID>",
        "workspaceResourceId": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-appmon-openshift-demo/providers/Microsoft.OperationalInsights/workspaces/law-appmon"
      }
    ]
  },
  "immutableId": "dcr-<IMMUTABLE_ID>",
  "kind": "Linux",
  "location": "indonesiacentral",
  "name": "dcr-minibank-dbsnap",
  "resourceGroup": "rg-appmon-openshift-demo",
  "streamDeclarations": {
    "Custom-Json-MiniBankDbSnap_CL": {
      "columns": [
        {
          "name": "TimeGenerated",
          "type": "datetime"
        },
        {
          "name": "Computer",
          "type": "string"
        },
        {
          "name": "FilePath",
          "type": "string"
        },
        {
          "name": "DbEngine",
          "type": "string"
        },
        {
          "name": "SnapshotType",
          "type": "string"
        },
        {
          "name": "Name",
          "type": "string"
        },
        {
          "name": "Value",
          "type": "real"
        },
        {
          "name": "Detail",
          "type": "string"
        }
      ]
    }
  },
  "tags": {
    "demo": "minibank",
    "owner": "labadmin",
    "purpose": "appmon-openshift-demo"
  },
  "type": "Microsoft.Insights/dataCollectionRules"
}