          },
          {
            "type": 1,
            "name": "la-capacity-note",
            "content": {
              "json": "*How to read:* the trend is a straight line through the readings of up to 7 days; days left = (limit - now) / trend per day. Too little history means the collector started recently: the row is judged on its level only until a full day of readings exists. OpenShift 'Spare ... if this node fails' adds up the free requests on the other ready nodes and subtracts the movable pods of that node (pod placement rules ignored)."
            }
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "capacity"
      }
    },
    {
