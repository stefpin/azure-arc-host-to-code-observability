          },
          {
            "type": 3,
            "name": "la-speed-chart",
            "content": {
              "version": "KqlItem/1.0",
              "query": "let r = materialize(MiniBankLaReadings(7d)\n| where  Item startswith 'Business transactions P95'\n| extend x = (TimeGenerated - now()) / 1d);\nlet s = materialize(r\n| summarize n = count(), sx = sum(x), sy = sum(Value), sxx = sum(x * x), sxy = sum(x * Value)\n| extend b = (n * sxy - sx * sy) / (n * sxx - sx * sx)\n| extend a = (sy - b * sx) / n);\nlet a = toscalar(s | project a);\nlet b = toscalar(s | project b);\nr\n| project TimeGenerated, ['P95 per hour'] = Value, ['Trend (straight line)'] = a + b * x, ['Warning 800 ms'] = 800.0, ['Limit 1000 ms'] = 1000.0\n| order by TimeGenerated asc",
              "size": 0,
              "title": "Business transactions P95 per hour (ms): warning 800 ms, limit 1000 ms (drills left out)",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-appmon-openshift-demo/providers/Microsoft.OperationalInsights/workspaces/law-appmon"
              ],
              "visualization": "timechart",
              "chartSettings": {
                "seriesLabelSettings": [
                  {
                    "seriesName": "P95 per hour",
                    "color": "blue"
                  },
                  {
                    "seriesName": "Trend (straight line)",
                    "color": "purple"
                  },
                  {
                    "seriesName": "Warning 800 ms",
                    "color": "orange"
                  },
                  {
                    "seriesName": "Limit 1000 ms",
                    "color": "redBright"
                  }
                ],
                "ySettings": {
                  "min": 0
                },
                "showMetrics": false,
                "showLegend": true
              }
            }
          },
          {
            "type": 1,
            "name": "la-speed-note",
            "content": {
              "json": "*How to read the speed trend:* P95 = 95 % of the business transactions (transfer, QRIS payment, statement) finish faster than this; lab drills are left out. The purple line is a straight-line trend through the hourly readings. **Watch** when the trend reaches the 800 ms warning within 30 days; **Act** when it reaches the 1000 ms limit within 7 days (the '95 % under 1 s' target). The register row gives both dates."
            }
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "service"
      }
    },
