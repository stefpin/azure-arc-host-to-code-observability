          },
          {
            "type": 3,
            "name": "la-burn",
            "content": {
              "version": "KqlItem/1.0",
              "query": "let st = max_of(ago(7d), datetime(2026-11-13T07:00:00Z));\nlet dm = MiniBankDrillMinutes(st);\nAppRequests\n| where TimeGenerated > st and AppRoleName == 'minibank-api' and (Name endswith '/api/transfer' or Name endswith '/api/qris/pay' or Name endswith '/statement')\n| extend T = bin(TimeGenerated, 1m)\n| join kind=leftanti dm on T\n| summarize ['Failed %'] = 100.0 * sumif(ItemCount, toint(ResultCode) >= 500) / sum(ItemCount), ['Slower than 1 s %'] = 100.0 * sumif(ItemCount, DurationMs > 1000) / sum(ItemCount) by bin(TimeGenerated, 1h)\n| extend ['Allowed failed 0.5 %'] = 0.5, ['Allowed slow 5 %'] = 5.0\n| order by TimeGenerated asc",
              "size": 0,
              "title": "Failed and slow business transactions per hour (drills left out)",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-appmon-openshift-demo/providers/Microsoft.OperationalInsights/workspaces/law-appmon"
              ],
              "visualization": "timechart"
            }
          },
          {
            "type": 1,
            "name": "la-budget-note",
            "content": {
              "json": "*How to read:* the budget is the number of failed (or slower than 1 s) business transactions the target allows in the window. Burn rate 1x uses it exactly as fast as it is earned; days to zero is shown only when the last 24 hours use more than they earn."
            }
          },
          {
            "type": 3,
            "name": "la-speed-risks",
            "content": {
              "version": "KqlItem/1.0",
              "query": "MiniBankLookahead()\n| where Lens == 'Service'",
