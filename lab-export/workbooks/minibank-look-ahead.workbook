          {
            "type": 3,
            "name": "la-calendar-chart",
            "content": {
              "version": "KqlItem/1.0",
              "query": "MiniBankLookahead()\n| where Lens == 'Calendar'\n| project Item = strcat(Item, ' (', Resource, ')'), DaysLeft = min_of(DaysLeft, 400.0)\n| order by DaysLeft asc",
