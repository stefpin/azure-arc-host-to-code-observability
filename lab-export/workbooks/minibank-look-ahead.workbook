          {
            "type": 3,
            "name": "la-defender",
            "content": {
              "version": "KqlItem/1.0",
              "query": "securityresources\n| where type == 'microsoft.security/assessments' and tolower(id) contains '/resourcegroups/rg-appmon-openshift-demo/'\n| where tostring(properties.status.code) == 'Unhealthy'\n| summarize Findings = count(), Recommendations = dcount(tostring(properties.displayName)) by Severity = tostring(properties.metadata.severity)\n| order by Findings desc",
              "size": 0,
              "title": "Defender for Cloud: open findings in the demo resource group (live)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "/subscriptions/<SUBSCRIPTION_ID>"
              ],
              "visualization": "table"
            }
          },
          {
            "type": 3,
            "name": "la-advisor",
            "content": {
              "version": "KqlItem/1.0",
              "query": "advisorresources\n| where type == 'microsoft.advisor/recommendations' and tolower(tostring(properties.resourceMetadata.resourceId)) contains '/resourcegroups/rg-appmon-openshift-demo/'\n| summarize Recommendations = count() by Category = tostring(properties.category), Impact = tostring(properties.impact)\n| order by Recommendations desc",
              "size": 0,
              "title": "Azure Advisor recommendations (live)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "/subscriptions/<SUBSCRIPTION_ID>"
              ],
              "visualization": "table"
            }
          },
          {
            "type": 3,
            "name": "la-policy",
            "content": {
              "version": "KqlItem/1.0",
              "query": "policyresources\n| where type == 'microsoft.policyinsights/policystates' and tolower(tostring(properties.resourceGroup)) == 'rg-appmon-openshift-demo'\n| summarize NonCompliantResources = dcountif(tostring(properties.resourceId), tostring(properties.complianceState) == 'NonCompliant'), Policies = dcountif(tostring(properties.policyDefinitionId), tostring(properties.complianceState) == 'NonCompliant'), Resources = dcount(tostring(properties.resourceId))",
              "size": 0,
              "title": "Azure Policy compliance (live)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "/subscriptions/<SUBSCRIPTION_ID>"
              ],
              "visualization": "table"
            }
          },
          {
            "type": 3,
            "name": "la-posture-trend",
            "content": {
              "version": "KqlItem/1.0",
              "query": "MiniBankLookahead_CL\n| where TimeGenerated > ago(30d) and Kind == 'posture'\n| summarize Value = max(Value) by Day = bin(TimeGenerated + 7h, 1d), Item = strcat(Resource, ': ', Item)\n| order by Day asc",
              "size": 0,
              "title": "Posture trend (daily readings)",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-appmon-openshift-demo/providers/Microsoft.OperationalInsights/workspaces/law-appmon"
              ],
              "visualization": "linechart"
            }
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "posture"
