            "name": "la-score-note",
            "content": {
              "json": "*How to read:* every day at 10:00 WIB the collector saves a forecast for the next 24 hours (trend through the previous days, band +/-15 % or +/-2 standard errors). Live rows are those saved forecasts checked against what happened; back-test rows apply the same method afterwards to earlier days and are labelled as such."
            }
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "score"
      }
    },
    {
      "type": 12,
      "name": "la-g-collector",
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "name": "la-collector",
            "content": {
              "version": "KqlItem/1.0",
              "query": "MiniBankLookahead_CL\n| where TimeGenerated > ago(3d) and Kind == 'collector'\n| project TimeWIB = format_datetime(TimeGenerated + 7h, 'yyyy-MM-dd HH:mm'), Seconds = round(Value, 0), Text\n| order by TimeWIB desc\n| take 72",
              "size": 0,
              "title": "Collector runs (HV-HOST-02, hourly at :05; skips during lab drills)",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
