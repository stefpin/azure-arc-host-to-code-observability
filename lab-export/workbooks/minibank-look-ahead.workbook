    {
      "type": 12,
      "name": "la-g-capacity",
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 9,
            "name": "la-metric-param",
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "la-metric",
                  "version": "KqlParameterItem/1.0",
                  "name": "Metric",
                  "label": "Reading",
                  "type": 2,
                  "isRequired": true,
                  "query": "MiniBankLaReadings(7d)\n| summarize by Key = strcat(Area, ' | ', Resource, ' | ', Item)\n| order by Key asc",
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "queryType": 0,
                  "resourceType": "microsoft.operationalinsights/workspaces",
                  "crossComponentResources": [
                    "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-appmon-openshift-demo/providers/Microsoft.OperationalInsights/workspaces/law-appmon"
                  ],
                  "value": "Host | HV-HOST-02 | CPU busy (P95 per hour)"
                }
              ],
              "style": "pills",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            }
          },
          {
            "type": 3,
            "name": "la-forecast",
            "content": {
              "version": "KqlItem/1.0",
              "query": "let k = '{Metric}';\nlet r = MiniBankLaReadings(7d) | where strcat(Area, ' | ', Resource, ' | ', Item) == k;\nlet stp = iff(k has 'per day', 1d, 1h);\nlet st = toscalar(r | summarize min(TimeGenerated));\nlet lim = toscalar(r | summarize take_any(coalesce(Limit, Low)));\nr\n| make-series Reading = avg(Value) default = real(null) on TimeGenerated from bin(st, stp) to now() + 7d step stp\n| extend Forecast = series_decompose_forecast(series_fill_linear(Reading), toint(7d / stp))\n| extend Limit = repeat(lim, array_length(Reading))\n| mv-expand TimeGenerated to typeof(datetime), Reading to typeof(real), Forecast to typeof(real), Limit to typeof(real)\n| project TimeGenerated, Reading, ['Trend and forecast'] = Forecast, Limit",
              "size": 0,
              "title": "Reading, trend and 7-day forecast (dashed limit where the reading has one)",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-appmon-openshift-demo/providers/Microsoft.OperationalInsights/workspaces/law-appmon"
              ],
              "visualization": "timechart",
              "chartSettings": {
                "seriesLabelSettings": [
                  {
                    "seriesName": "Limit",
                    "color": "redBright"
                  },
                  {
                    "seriesName": "Trend and forecast",
                    "color": "purple"
                  }
                ]
              }
            }
          },
          {
            "type": 3,
            "name": "la-capacity",
            "content": {
              "version": "KqlItem/1.0",
              "query": "MiniBankLookahead()\n| where Lens == 'Capacity'",
